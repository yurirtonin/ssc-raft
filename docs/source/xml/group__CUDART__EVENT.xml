      <memberdef kind="function" id="group__CUDART__EVENT_1gabff85920872d5ed4aaf7b618e392f514" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>__host__ cudaError_t CUDARTAPI</type>
        <definition>__host__ cudaError_t CUDARTAPI cudaEventQuery</definition>
        <argsstring>(cudaEvent_t event)</argsstring>
        <name>cudaEventQuery</name>
        <param>
          <type>cudaEvent_t</type>
          <declname>event</declname>
        </param>
        <briefdescription>
<para>Queries an event&apos;s status. </para>
        </briefdescription>
        <detaileddescription>
<para>Queries the status of all work currently captured by <computeroutput>event</computeroutput>. See <ref refid="group__CUDART__EVENT_1ga456a07ba2685ccd5ccfc84a5d171ad02" kindref="member">cudaEventRecord()</ref> for details on what is captured by an event.</para>
<para>Returns ::cudaSuccess if all captured work has been completed, or ::cudaErrorNotReady if any captured work is incomplete.</para>
<para>For the purposes of Unified Memory, a return value of ::cudaSuccess is equivalent to having called <ref refid="group__CUDART__EVENT_1ga94b4ebd303bec5ef0b0f2b0235fe0ab1" kindref="member">cudaEventSynchronize()</ref>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>event</parametername>
</parameternamelist>
<parameterdescription>
<para>- Event to query</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>::cudaSuccess, ::cudaErrorNotReady, ::cudaErrorInvalidValue, ::cudaErrorInvalidResourceHandle, ::cudaErrorLaunchFailure \notefnerr \note_init_rt \note_callback</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__CUDART__EVENT_1gaf95514807c666994e61b94c93ef10a2b" kindref="member">cudaEventCreate (C API)</ref>, <ref refid="group__CUDART__EVENT_1ga80341dd18a63acb6be0d8afa874821ed" kindref="member">cudaEventCreateWithFlags</ref>, <ref refid="group__CUDART__EVENT_1ga456a07ba2685ccd5ccfc84a5d171ad02" kindref="member">cudaEventRecord</ref>, <ref refid="group__CUDART__EVENT_1ga94b4ebd303bec5ef0b0f2b0235fe0ab1" kindref="member">cudaEventSynchronize</ref>, <ref refid="group__CUDART__EVENT_1gac8f42aa081e464ada1a59cd5e6ae3015" kindref="member">cudaEventDestroy</ref>, <ref refid="group__CUDART__EVENT_1gabb6db9fb36a249aec6cee068fadf7943" kindref="member">cudaEventElapsedTime</ref>, ::cuEventQuery </para>
</simplesect>
</para>
        </detaileddescription>

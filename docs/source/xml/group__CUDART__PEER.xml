      <memberdef kind="function" id="group__CUDART__PEER_1gad1d17e928a31f1cb1691a42de480c2d3" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>__host__ cudaError_t CUDARTAPI</type>
        <definition>__host__ cudaError_t CUDARTAPI cudaDeviceDisablePeerAccess</definition>
        <argsstring>(int peerDevice)</argsstring>
        <name>cudaDeviceDisablePeerAccess</name>
        <param>
          <type>int</type>
          <declname>peerDevice</declname>
        </param>
        <briefdescription>
<para>Disables direct access to memory allocations on a peer device. </para>
        </briefdescription>
        <detaileddescription>
<para>Returns ::cudaErrorPeerAccessNotEnabled if direct access to memory on <computeroutput>peerDevice</computeroutput> has not yet been enabled from the current device.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>peerDevice</parametername>
</parameternamelist>
<parameterdescription>
<para>- Peer device to disable direct access to</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>::cudaSuccess, ::cudaErrorPeerAccessNotEnabled, ::cudaErrorInvalidDevice \notefnerr \note_init_rt \note_callback</para>
</simplesect>
<simplesect kind="see"><para><ref refid="group__CUDART__PEER_1ga46cf1454e8daa73d9bc17aa5a1589a38" kindref="member">cudaDeviceCanAccessPeer</ref>, <ref refid="group__CUDART__PEER_1ga7443ed162ccf7463a7caf15dc799cc6d" kindref="member">cudaDeviceEnablePeerAccess</ref>, ::cuCtxDisablePeerAccess </para>
</simplesect>
</para>
        </detaileddescription>

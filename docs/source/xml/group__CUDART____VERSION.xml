      <memberdef kind="function" id="group__CUDART____VERSION_1ga7aa68c528a22917b05dc6b526258e968" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>__host__ __cudart_builtin__ cudaError_t CUDARTAPI</type>
        <definition>__host__ __cudart_builtin__ cudaError_t CUDARTAPI cudaRuntimeGetVersion</definition>
        <argsstring>(int *runtimeVersion)</argsstring>
        <name>cudaRuntimeGetVersion</name>
        <param>
          <type>int *</type>
          <declname>runtimeVersion</declname>
        </param>
        <briefdescription>
<para>Returns the CUDA Runtime version. </para>
        </briefdescription>
        <detaileddescription>
<para>Returns in <computeroutput>*runtimeVersion</computeroutput> the version number of the current CUDA Runtime instance. The version is returned as (1000 <times/> major + 10 <times/> minor). For example, CUDA 9.2 would be represented by 9020.</para>
<para>This function automatically returns ::cudaErrorInvalidValue if the <computeroutput>runtimeVersion</computeroutput> argument is NULL.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>runtimeVersion</parametername>
</parameternamelist>
<parameterdescription>
<para>- Returns the CUDA Runtime version.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>::cudaSuccess, ::cudaErrorInvalidValue \note_init_rt \note_callback</para>
</simplesect>
